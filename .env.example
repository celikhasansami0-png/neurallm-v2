# ===== REQUIRED =====

# Clerk Auth — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
CLERK_WEBHOOK_SECRET=whsec_...

# Groq AI — https://console.groq.com (FREE)
GROQ_API_KEY=gsk_...

# Supabase DB — https://supabase.com
DATABASE_URL=postgresql://...

# Resend Email — https://resend.com (FREE up to 100/day)
RESEND_API_KEY=re_...

# Encryption key (32 char random string)
ENCRYPTION_KEY=your_32_char_random_string_here_!

# App URL
NEXT_PUBLIC_APP_URL=https://neurallm.vercel.app

# ===== OPTIONAL =====

# OpenAI — for better embeddings (falls back to hash if not set)
OPENAI_API_KEY=sk-...

# Stripe — for billing
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_TEAM=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# OAuth integrations (add as you connect each one)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
